# ==========================================================
# DEL CAMPO A TUS MANOS - VARIABLES DE ENTORNO (.env)
# CONTRATO OWASP / AGENTS.md / RULES.md
# ==========================================================

# Puerto del servidor backend
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV=development

# Configuración de Base de Datos MySQL (TRD §2)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=del_campo_a_tus_manos

# Seguridad JWT
JWT_SECRET=super_secret_jwt_del_campo_a_tus_manos_2026_adso_agro_key!
JWT_EXPIRES_IN=8h

# Configuración SMTP (RF-07 Notificaciones asíncronas)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass
SMTP_FROM=no-reply@delcampoatusmanos.co

# CORS - Orígenes permitidos (RULES.md: CORS-POL/ORIGIN)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
